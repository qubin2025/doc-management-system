# 全过程工程咨询管理系统 — 后端环境变量
# 复制此文件为 .env 并填入实际值

PORT=3000
DB_PATH=./data/planning.db
FILES_PATH=./files

# 会话管理（系统使用 UUID Session 存储在数据库 sessions 表，非 JWT）
# Session 过期时间默认 24 小时，在 backend/routes/auth.js 中配置 SESSION_HOURS

# 日志前缀（用于环境区分，便于 grep 过滤）
# 开发环境用 [DOC-LIST]/[DOC-DL]，测试/生产可加环境标识如 [TEST][DOC-DL]
LOG_PREFIX_DOC_LIST=DOC-LIST
LOG_PREFIX_DOC_DOWNLOAD=DOC-DL
# 环境标识（会拼接到日志前缀，留空则不拼）
LOG_ENV_TAG=

# AI 模型 API Keys（请填入实际密钥）
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
ZHIPU_API_KEY=your-zhipu-api-key
QWEN_API_KEY=sk-your-qwen-api-key
DASHSCOPE_API_KEY=sk-your-dashscope-api-key

# Neo4j 知识图谱（可选，不配置则自动使用离线模式）
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=changeme123

# 生产环境
# NODE_ENV=production
# CORS_ORIGIN=https://your-domain.com
