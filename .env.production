# ===== 生产环境配置 =====
# 部署前必须修改以下配置项

# 前端API地址（Nginx反向代理可用相对路径 /api）
VITE_API_URL=/api
VITE_DISABLE_DEMO=true

# 后端端口
PORT=3000
NODE_ENV=production

# JWT密钥 — 必须修改为随机字符串(openssl rand -hex 32)
JWT_SECRET=change-me-to-random-64-char-string

# 数据库路径
DB_PATH=./backend/data/planning.db
FILES_PATH=./backend/files

# CORS白名单（多个用逗号分隔，留空允许同源）
CORS_ORIGIN=

# AI模型API Key（至少配置一个）
DEEPSEEK_API_KEY=sk-your-deepseek-key
ZHIPU_API_KEY=your-zhipu-key
QWEN_API_KEY=your-qwen-key
DASHSCOPE_API_KEY=your-dashscope-key

# Neo4j知识图谱（可选）
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme123

# PostgreSQL（可选，DB_TYPE=postgres时生效）
DB_TYPE=sqlite
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=doc_mgmt
PG_USER=postgres
PG_PASSWORD=postgres
PG_POOL_MAX=10

# OAuth/OIDC（可选）
OAUTH_ENABLED=false
OAUTH_PROVIDER=google
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_CALLBACK_URL=https://your-domain.com/api/oauth/callback
