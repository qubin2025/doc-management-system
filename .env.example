# 全过程工程咨询管理系统 — 前端环境变量（开发）
# 复制此文件为 .env 并填入实际值

# 后端 API 地址（Nginx 反向代理场景使用 /api）
VITE_API_URL=http://localhost:3000/api

# AI Keys — 后端优先代理，此 Key 仅为 fallback（后端不可用时）
# VITE_DEEPSEEK_API_KEY=sk-your-deepseek-api-key
# VITE_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# VITE_DEEPSEEK_MODEL=deepseek-chat
# VITE_ZHIPU_API_KEY=your-zhipu-api-key
# VITE_QWEN_API_KEY=sk-your-qwen-api-key

# 终端本地 AI 端口（可选）
# VITE_LOCAL_AI_PORT=11434

# 关闭离线演示入口（生产环境取消注释）
# VITE_DISABLE_DEMO=true
